APP_NAME="Evidence Collector & Compliance Pack"
APP_VERSION="0.1.0"
DATABASE_URL="sqlite:///./evidence_collector.db"
MYSQL_DATABASE_URL=""
CORS_ORIGINS='["http://localhost:5173"]'
UPLOADS_DIR="./data/uploads"
EXPORTS_DIR="./data/exports"
REPORTS_DIR="./data/reports"
MAX_UPLOAD_SIZE_MB=50
ALLOW_ORIGINAL_LOGS=false
REDACT_IPV6=true
ADB_EXECUTABLE="adb"
SCREENSHOT_CAPTURE_TIMEOUT_SECONDS=15
RUNTIME_LOG_CAPTURE_TIMEOUT_SECONDS=20
RUNTIME_LOG_CAPTURE_LINE_COUNT=400
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="mistralai/mistral-7b-instruct-v0.3"
OPENROUTER_SITE_URL="http://localhost:8000"
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_DEBUG_LOGGING=false
VITE_API_URL="http://localhost:8000/api"
